{
  "name": "atlas-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "check:repo": "node scripts/check-repo.mjs",
    "preview": "vite preview",
    "test:dbguard": "tsc src/dbGuardModel.ts --ignoreConfig --outDir node_modules/.cache/dbguard --module esnext --target es2020 && echo '{\"type\":\"module\"}' > node_modules/.cache/dbguard/package.json && node scripts/tests/dbGuardModel.test.mjs"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.22",
    "@types/topojson-client": "^3.1.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "d3": "^7.9.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "leaflet.vectorgrid": "^1.3.0",
    "topojson-client": "^3.1.0"
  }
}
